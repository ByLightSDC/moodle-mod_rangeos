{{!
    Activity environment assignment page.

    @template   local_rangeos/activity_environments
    @copyright  2026 Bylight
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div>
    {{^hasenvironments}}
    {{#emptyenvironments}}
    {{> local_rangeos/empty_state }}
    {{/emptyenvironments}}
    {{/hasenvironments}}

    {{#hasenvironments}}

    <form id="rangeos-activity-search-form" class="rangeos-toolbar" action="{{baseurl}}" method="get">
        <div class="rangeos-toolbar-group">
            <div class="rangeos-field rangeos-field-grow">
                <label for="rangeos-activity-search">{{#str}}searchactivities, local_rangeos{{/str}}</label>
                <input type="search"
                       id="rangeos-activity-search"
                       name="search"
                       class="form-control"
                       value="{{search}}"
                       placeholder="{{#str}}searchactivities_placeholder, local_rangeos{{/str}}"
                       autocomplete="off">
            </div>
            <button type="submit" class="btn btn-outline-primary">
                {{> local_rangeos/icon_search }}
                {{#str}}search{{/str}}
            </button>
            {{#hasfilters}}
            <a href="{{baseurl}}" class="btn btn-outline-secondary">
                {{#str}}clearfilters, local_rangeos{{/str}}
            </a>
            {{/hasfilters}}
        </div>

        <div class="rangeos-field rangeos-field-env">
            <label for="rangeos-env-filter">{{#str}}filterbyenvironment, local_rangeos{{/str}}</label>
            <select id="rangeos-env-filter" name="envfilter" class="custom-select">
                {{#envfilteroptions}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/envfilteroptions}}
            </select>
        </div>
    </form>

    {{#hasactivities}}
    <p class="rangeos-result-count">{{rowsummary}}</p>
    <div class="table-responsive rangeos-table-panel">
    <table class="table" id="rangeos-activity-env-table">
        <thead>
            <tr>
                <th>{{#str}}course{{/str}}</th>
                <th>{{#str}}activity, local_rangeos{{/str}}</th>
                <th>{{#str}}environment, local_rangeos{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#activities}}
            <tr data-cmi5id="{{cmi5id}}" data-current-envid="{{currentenvid}}">
                <td>
                    <a href="{{activityurl}}" class="text-muted small">{{coursename}}</a>
                </td>
                <td>
                    <a href="{{activityurl}}">{{activityname}}</a>
                </td>
                <td>
                    <select class="custom-select custom-select-sm"
                            data-action="assign-environment"
                            data-cmi5id="{{cmi5id}}">
                        {{#envoptions}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/envoptions}}
                    </select>
                    <span class="rangeos-save-indicator" role="status" aria-live="polite"></span>
                </td>
            </tr>
            {{/activities}}
        </tbody>
    </table>
    </div>
    {{/hasactivities}}

    {{^hasactivities}}
    {{#emptyrows}}
    {{> local_rangeos/empty_state }}
    {{/emptyrows}}
    {{/hasactivities}}

    {{/hasenvironments}}
</div>
