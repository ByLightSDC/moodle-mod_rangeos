{{!
    Per-activity AU mapping view.

    The rows are local_rangeos/au_row, the same component the library listing uses, so an
    AU reads the same way wherever it is shown: title first, IRI as secondary text, and
    everything else opened in place. See that template for the row's context.

    @template   local_rangeos/activity_au_mappings
    @copyright  2026 Bylight
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div data-baseurl="{{baseurl}}">
    <a href="{{backurl}}" class="mod-cmi5-lib-back">
        <span aria-hidden="true">&larr;</span> {{#str}}backtoactivity, local_rangeos{{/str}}
    </a>

    <div class="rangeos-toolbar">
        {{> local_rangeos/environment_selector }}
    </div>

    {{#haserror}}
    <div class="alert alert-danger">{{error}}</div>
    {{/haserror}}

    {{#hasaus}}
    <p class="rangeos-result-count">{{rowsummary}}</p>
    <div class="table-responsive rangeos-table-panel">
    <table class="table rangeos-au-table">
        <thead>
            <tr>
                <th>{{#str}}au_title, local_rangeos{{/str}}</th>
                <th class="rangeos-au-col-scenario">{{#str}}scenarios, local_rangeos{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#aus}}
            {{> local_rangeos/au_row }}
            {{/aus}}
        </tbody>
    </table>
    </div>
    {{/hasaus}}

    {{^hasenvironments}}
    {{#emptyenvironments}}
    {{> local_rangeos/empty_state }}
    {{/emptyenvironments}}
    {{/hasenvironments}}

    {{#hasenvironments}}
    {{^hasaus}}
    {{^haserror}}
    {{#emptyrows}}
    {{> local_rangeos/empty_state }}
    {{/emptyrows}}
    {{/haserror}}
    {{/hasaus}}
    {{/hasenvironments}}
</div>
