{{!
    Per-activity AU mapping view.

    @template   local_rangeos/activity_au_mappings
    @copyright  2026 Bylight
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div data-baseurl="{{baseurl}}">
    <a href="{{backurl}}" class="mod-cmi5-lib-back">
        <span aria-hidden="true">&larr;</span> {{#str}}backtoactivity, local_rangeos{{/str}}
    </a>

    <div class="rangeos-toolbar">
        {{> local_rangeos/environment_selector }}
    </div>

    {{#haserror}}
    <div class="alert alert-danger">{{error}}</div>
    {{/haserror}}

    {{#hasaus}}
    <div class="table-responsive rangeos-table-panel">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>{{#str}}au_iri, local_rangeos{{/str}}</th>
                <th>{{#str}}au_title, local_rangeos{{/str}}</th>
                <th>{{#str}}status, local_rangeos{{/str}}</th>
                <th>{{#str}}scenarios, local_rangeos{{/str}}</th>
                {{#canmanage}}
                <th>{{#str}}actions{{/str}}</th>
                {{/canmanage}}
            </tr>
        </thead>
        <tbody>
            {{#aus}}
            <tr>
                <td><code title="{{auid}}">{{auid}}</code></td>
                <td>{{title}}</td>
                <td>
                    {{#has_mapping}}
                    <span class="rangeos-pill rangeos-pill-ok">{{#str}}mapped, local_rangeos{{/str}}</span>
                    {{/has_mapping}}
                    {{^has_mapping}}
                    <span class="rangeos-pill rangeos-pill-warn">{{#str}}unmapped, local_rangeos{{/str}}</span>
                    {{/has_mapping}}
                </td>
                <td>{{scenarios_display}}</td>
                {{#canmanage}}
                <td class="rangeos-row-actions">
                    {{#has_mapping}}
                    <button class="btn btn-sm btn-outline-primary"
                            data-action="edit-mapping"
                            data-auid="{{auid}}"
                            data-autitle="{{title}}">
                        {{#str}}edit{{/str}}
                    </button>
                    {{/has_mapping}}
                    {{^has_mapping}}
                    <button class="btn btn-sm btn-outline-success"
                            data-action="create-mapping"
                            data-auid="{{auid}}"
                            data-autitle="{{title}}">
                        {{#str}}createmapping, local_rangeos{{/str}}
                    </button>
                    {{/has_mapping}}
                </td>
                {{/canmanage}}
            </tr>
            {{/aus}}
        </tbody>
    </table>
    </div>
    {{/hasaus}}

    {{^hasaus}}
    {{^haserror}}
    <div class="alert alert-info rangeos-empty-state">
        {{#str}}noaus, local_rangeos{{/str}}
    </div>
    {{/haserror}}
    {{/hasaus}}
</div>
