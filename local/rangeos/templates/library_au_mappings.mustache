{{!
    Library package AU-to-scenario mapping page.

    @template   local_rangeos/library_au_mappings
    @copyright  2026 Bylight
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div data-baseurl="{{baseurl}}" data-versionid="{{versionid}}">
    {{^hasenvironments}}
    <div class="alert alert-info rangeos-empty-state">
        {{#str}}noenvironments, local_rangeos{{/str}}
    </div>
    {{/hasenvironments}}

    <div class="rangeos-toolbar">
        {{#haspackages}}
        <form id="rangeos-package-search-form" class="rangeos-toolbar-group">
            <div class="rangeos-field rangeos-field-grow">
                <label for="rangeos-package-search">{{#str}}searchprojects, local_rangeos{{/str}}</label>
                <input type="search"
                       id="rangeos-package-search"
                       class="form-control"
                       list="rangeos-package-suggestions"
                       value="{{packagetitle}}"
                       placeholder="{{#str}}searchprojects_placeholder, local_rangeos{{/str}}"
                       data-invalid-message="{{#str}}searchprojects_invalid, local_rangeos{{/str}}"
                       autocomplete="off">
            </div>
            <button type="submit" class="btn btn-outline-primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4.2-4.2"/></svg>
                {{#str}}search{{/str}}
            </button>
            <datalist id="rangeos-package-suggestions">
                {{#packages}}
                <option value="{{title}}" data-packageid="{{id}}"></option>
                {{/packages}}
            </datalist>
        </form>
        {{/haspackages}}
        {{> local_rangeos/environment_selector }}
    </div>

    {{#haserror}}
    <div class="alert alert-danger">{{error}}</div>
    {{/haserror}}

    {{#hasenvironments}}
    <div class="rangeos-actions">
        <a href="{{mapallurl}}"
           class="btn btn-success"
           onclick="return confirm('This will create mappings for every unmapped AU that has a default scenario in its RC5 config. Continue?')">
            {{#str}}mapalldefaults, local_rangeos{{/str}}
        </a>
        <small class="text-muted ml-2">{{#str}}mapalldefaults_desc, local_rangeos{{/str}}</small>
    </div>
    {{/hasenvironments}}

    {{#hasmapresults}}
    {{#mapresults}}
    <div class="card mb-4">
        <div class="card-header font-weight-bold">Map all defaults — results</div>
        <div class="card-body p-0">
            {{#hascreated}}
            <div class="px-3 py-3{{#hasfailed}} border-bottom{{/hasfailed}}">
                <h6 class="text-success mb-3">Created ({{createdcount}})</h6>
                {{#created_by_course}}
                <p class="mb-1 small font-weight-bold text-muted text-uppercase">
                    {{#hascourse}}Course ID: {{courseid}}{{/hascourse}}
                    {{^hascourse}}No local course{{/hascourse}}
                    <span class="rangeos-tag ml-1">{{itemcount}}</span>
                </p>
                <div class="table-responsive rangeos-table-panel">
                <table class="table table-sm table-bordered mb-3">
                    <thead class="thead-light"><tr><th>AU</th><th>Scenario</th></tr></thead>
                    <tbody>
                        {{#items}}
                        <tr>
                            <td>
                                {{title}}
                                <br><code class="small text-muted text-break">{{auid}}</code>
                            </td>
                            <td>{{scenarioname}}</td>
                        </tr>
                        {{/items}}
                    </tbody>
                </table>
                </div>
                {{/created_by_course}}
            </div>
            {{/hascreated}}
            {{#hasfailed}}
            <div class="px-3 py-3">
                <h6 class="text-danger mb-3">Failed ({{failedcount}})</h6>
                {{#failed_by_course}}
                <p class="mb-1 small font-weight-bold text-muted text-uppercase">
                    {{#hascourse}}Course ID: {{courseid}}{{/hascourse}}
                    {{^hascourse}}No local course{{/hascourse}}
                    <span class="rangeos-tag ml-1">{{itemcount}}</span>
                </p>
                <div class="table-responsive rangeos-table-panel">
                <table class="table table-sm table-bordered mb-3">
                    <thead class="thead-light"><tr><th>AU</th><th>Scenario</th><th>Reason</th></tr></thead>
                    <tbody>
                        {{#items}}
                        <tr>
                            <td>
                                {{title}}
                                <br><code class="small text-muted text-break">{{auid}}</code>
                            </td>
                            <td>{{scenarioname}}</td>
                            <td class="text-danger">{{reason}}</td>
                        </tr>
                        {{/items}}
                    </tbody>
                </table>
                </div>
                {{/failed_by_course}}
            </div>
            {{/hasfailed}}
            {{^hascreated}}{{^hasfailed}}
            <div class="px-3 py-3 text-muted">
                No new mappings created.
                {{#skipped}}({{skipped}} already mapped.){{/skipped}}
            </div>
            {{/hasfailed}}{{/hascreated}}
        </div>
        {{#skipped}}
        <div class="card-footer text-muted small">{{skipped}} AU(s) skipped — already mapped.</div>
        {{/skipped}}
    </div>
    {{/mapresults}}
    {{/hasmapresults}}

    <p class="text-muted">
        {{#str}}librarymapping_scope, local_rangeos{{/str}}
    </p>

    {{#hasselectedpackage}}
    <h4 class="rangeos-section-title">{{packagetitle}}</h4>
    {{/hasselectedpackage}}

    {{#hasaus}}
    <p class="rangeos-result-count">{{rowsummary}}</p>
    <div class="table-responsive rangeos-table-panel">
    <table class="table rangeos-au-table">
        <thead>
            <tr>
                <th>{{#str}}au_title, local_rangeos{{/str}}</th>
                <th class="rangeos-au-col-scenario">{{#str}}scenarios, local_rangeos{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#aus}}
            <tr class="rangeos-au-row">
                <td>
                    <button type="button" class="rangeos-au-toggle" id="{{rowid}}"
                            data-action="toggle-au-detail"
                            aria-expanded="false" aria-controls="{{detailid}}">
                        <svg class="rangeos-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
                        <span class="rangeos-au-text">
                            {{#showpackagecolumn}}
                            <span class="rangeos-au-package">{{packagetitle}}</span>
                            {{/showpackagecolumn}}
                            <span class="rangeos-au-titleline">
                                <span class="rangeos-au-title">{{title}}</span>
                                {{#israngeos}}
                                <span class="rangeos-tag rangeos-tag-accent">RangeOS</span>
                                {{/israngeos}}
                            </span>
                            <code class="rangeos-auid">{{auid}}</code>
                        </span>
                    </button>
                </td>
                <td class="rangeos-au-col-scenario">
                    {{#israngeos}}
                        {{#scenario_count}}
                        <ul class="rangeos-scenario-list">
                            {{#scenario_badges}}
                            <li>{{.}}</li>
                            {{/scenario_badges}}
                        </ul>
                        {{/scenario_count}}
                        {{^scenario_count}}
                        <span class="rangeos-tag rangeos-tag-empty">None</span>
                        {{/scenario_count}}
                    {{/israngeos}}
                    {{^israngeos}}
                    <span class="text-muted">&mdash;</span>
                    {{/israngeos}}
                </td>
            </tr>
            <tr class="rangeos-au-detailrow" id="{{detailid}}" role="region" aria-labelledby="{{rowid}}" hidden>
                <td colspan="2">
                    <dl class="rangeos-detail-grid">
                        {{^showpackagecolumn}}
                        <dt>CMI5 Package</dt>
                        <dd>{{packagetitle}}</dd>
                        {{/showpackagecolumn}}

                        <dt>{{#str}}type, local_rangeos{{/str}}</dt>
                        <dd>
                            <span class="rangeos-tag">cmi5</span>
                            {{#israngeos}}<span class="rangeos-tag rangeos-tag-accent">RangeOS</span>{{/israngeos}}
                        </dd>

                        {{#scenarioname}}
                        <dt>{{#str}}defaultscenario, local_rangeos{{/str}}</dt>
                        <dd>
                            {{scenarioname}}
                            {{#defaultscenariomissing}}
                            <span class="rangeos-pill rangeos-pill-warn">Not in this environment</span>
                            {{/defaultscenariomissing}}
                        </dd>
                        {{/scenarioname}}

                        <dt>Activity</dt>
                        <dd>
                            {{#hasactivities}}
                            {{#activities}}
                            <div>
                                <a href="{{{config.wwwroot}}}/mod/cmi5/view.php?id={{cmid}}">{{activityname}}</a>
                                <span class="text-muted">({{coursename}})</span>
                            </div>
                            {{/activities}}
                            {{/hasactivities}}
                            {{^hasactivities}}
                            <span class="text-muted">&mdash;</span>
                            {{/hasactivities}}
                        </dd>

                        {{#hasselectedpackage}}
                        <dt>{{#str}}classmode, local_rangeos{{/str}}</dt>
                        <dd>
                            {{#israngeos}}
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input"
                                       id="classmode-{{rowid}}"
                                       data-action="toggle-classmode"
                                       data-auid="{{auid}}"
                                       {{#classmode}}checked{{/classmode}}>
                                <label class="custom-control-label" for="classmode-{{rowid}}"></label>
                            </div>
                            {{/israngeos}}
                            {{^israngeos}}
                            <span class="text-muted">&mdash;</span>
                            {{/israngeos}}
                        </dd>
                        {{/hasselectedpackage}}
                    </dl>

                    {{#israngeos}}
                    <div class="rangeos-detail-actions">
                        {{#ismapped}}
                        <button class="btn btn-outline-primary"
                                data-action="edit-mapping"
                                data-auid="{{auid}}"
                                data-autitle="{{mapping_name}}"
                                data-scenarios="{{scenarios_json}}">
                            {{#str}}editmapping, local_rangeos{{/str}}
                        </button>
                        {{/ismapped}}
                        {{^ismapped}}
                        {{#scenarioname}}
                        {{^defaultscenariomissing}}
                        <button class="btn btn-primary"
                                data-action="create-default-mapping"
                                data-auid="{{auid}}"
                                data-autitle="{{title}}"
                                data-defaultscenarioname="{{scenarioname}}">
                            {{#str}}usedefault, local_rangeos{{/str}}
                        </button>
                        {{/defaultscenariomissing}}
                        {{/scenarioname}}
                        <button class="btn btn-outline-primary"
                                data-action="create-mapping"
                                data-auid="{{auid}}"
                                data-autitle="{{title}}"
                                data-scenarios="[]">
                            {{#str}}createmapping, local_rangeos{{/str}}
                        </button>
                        {{#defaultscenariomissing}}
                        <span class="rangeos-detail-actions-note">
                            {{#str}}usedefault, local_rangeos{{/str}} unavailable: &ldquo;{{scenarioname}}&rdquo; is not in this environment.
                        </span>
                        {{/defaultscenariomissing}}
                        {{/ismapped}}
                    </div>
                    {{/israngeos}}
                </td>
            </tr>
            {{/aus}}
        </tbody>
    </table>
    </div>
    {{/hasaus}}

    {{^hasaus}}
    {{^haserror}}
    <div class="alert alert-info rangeos-empty-state">
        {{#str}}nolibraryaus, local_rangeos{{/str}}
    </div>
    {{/haserror}}
    {{/hasaus}}

</div>

{{#js}}
require(['core/first'], function() {
    var container = document.querySelector('[data-versionid]');
    var envSelect = document.getElementById('rangeos-env-select');
    var packageForm = document.getElementById('rangeos-package-search-form');
    var packageSearch = document.getElementById('rangeos-package-search');
    var packageOptions = Array.prototype.slice.call(
        document.querySelectorAll('#rangeos-package-suggestions option')
    );

    function applyFilters(selectedPackageId) {
        var url = new URL(container.dataset.baseurl, window.location.href);
        url.searchParams.set('envid', envSelect ? envSelect.value : '0');
        url.searchParams.set('packageid', selectedPackageId);
        url.searchParams.set('page', '0');
        window.location.href = url.toString();
    }

    if (packageForm) {
        packageSearch.addEventListener('input', function() {
            packageSearch.setCustomValidity('');
        });
        packageForm.addEventListener('submit', function(event) {
            event.preventDefault();
            var query = packageSearch.value.trim();
            // An empty field means every project, which is how the filter is cleared.
            if (!query) {
                applyFilters('0');
                return;
            }
            var match = packageOptions.find(function(option) {
                return option.value.toLocaleLowerCase() === query.toLocaleLowerCase();
            });
            if (!match) {
                packageSearch.setCustomValidity(packageSearch.dataset.invalidMessage);
                packageSearch.reportValidity();
                return;
            }
            applyFilters(match.dataset.packageid);
        });
    }
});
{{/js}}
