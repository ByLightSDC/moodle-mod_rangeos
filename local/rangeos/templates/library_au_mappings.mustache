{{!
    Library package AU-to-scenario mapping page.

    @template   local_rangeos/library_au_mappings
    @copyright  2026 Bylight
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div data-baseurl="{{baseurl}}" data-versionid="{{versionid}}">
    {{> local_rangeos/environment_selector }}

    {{^hasenvironments}}
    <div class="alert alert-info rangeos-empty-state">
        {{#str}}noenvironments, local_rangeos{{/str}}
    </div>
    {{/hasenvironments}}

    {{#haspackages}}
    <div class="form-group row rangeos-filter">
        <label for="rangeos-package-select" class="col-auto col-form-label">
            {{#str}}selectpackage, local_rangeos{{/str}}
        </label>
        <div class="col-sm-6">
            <select id="rangeos-package-select" class="custom-select">
                <option value="0">{{#str}}alllibrarypackages, local_rangeos{{/str}}</option>
                {{#packages}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{title}}</option>
                {{/packages}}
            </select>
        </div>
    </div>
    {{/haspackages}}

    {{#haserror}}
    <div class="alert alert-danger">{{error}}</div>
    {{/haserror}}

    {{#hasenvironments}}
    <div class="mb-3">
        <a href="{{mapallurl}}"
           class="btn btn-success"
           onclick="return confirm('This will create mappings for every unmapped AU that has a default scenario in its RC5 config. Continue?')">
            {{#str}}mapalldefaults, local_rangeos{{/str}}
        </a>
        <small class="text-muted ml-2">{{#str}}mapalldefaults_desc, local_rangeos{{/str}}</small>
    </div>
    {{/hasenvironments}}

    {{#hasmapresults}}
    {{#mapresults}}
    <div class="card mb-4">
        <div class="card-header font-weight-bold">Map all defaults — results</div>
        <div class="card-body p-0">
            {{#hascreated}}
            <div class="px-3 py-3{{#hasfailed}} border-bottom{{/hasfailed}}">
                <h6 class="text-success mb-3">Created ({{createdcount}})</h6>
                {{#created_by_course}}
                <p class="mb-1 small font-weight-bold text-muted text-uppercase">
                    {{#hascourse}}Course ID: {{courseid}}{{/hascourse}}
                    {{^hascourse}}No local course{{/hascourse}}
                    <span class="badge badge-secondary ml-1">{{itemcount}}</span>
                </p>
                <div class="table-responsive rangeos-table-panel">
                <table class="table table-sm table-bordered mb-3">
                    <thead class="thead-light"><tr><th>AU</th><th>Scenario</th></tr></thead>
                    <tbody>
                        {{#items}}
                        <tr>
                            <td>
                                {{title}}
                                <br><code class="small text-muted text-break">{{auid}}</code>
                            </td>
                            <td>{{scenarioname}}</td>
                        </tr>
                        {{/items}}
                    </tbody>
                </table>
                </div>
                {{/created_by_course}}
            </div>
            {{/hascreated}}
            {{#hasfailed}}
            <div class="px-3 py-3">
                <h6 class="text-danger mb-3">Failed ({{failedcount}})</h6>
                {{#failed_by_course}}
                <p class="mb-1 small font-weight-bold text-muted text-uppercase">
                    {{#hascourse}}Course ID: {{courseid}}{{/hascourse}}
                    {{^hascourse}}No local course{{/hascourse}}
                    <span class="badge badge-secondary ml-1">{{itemcount}}</span>
                </p>
                <div class="table-responsive rangeos-table-panel">
                <table class="table table-sm table-bordered mb-3">
                    <thead class="thead-light"><tr><th>AU</th><th>Scenario</th><th>Reason</th></tr></thead>
                    <tbody>
                        {{#items}}
                        <tr>
                            <td>
                                {{title}}
                                <br><code class="small text-muted text-break">{{auid}}</code>
                            </td>
                            <td>{{scenarioname}}</td>
                            <td class="text-danger">{{reason}}</td>
                        </tr>
                        {{/items}}
                    </tbody>
                </table>
                </div>
                {{/failed_by_course}}
            </div>
            {{/hasfailed}}
            {{^hascreated}}{{^hasfailed}}
            <div class="px-3 py-3 text-muted">
                No new mappings created.
                {{#skipped}}({{skipped}} already mapped.){{/skipped}}
            </div>
            {{/hasfailed}}{{/hascreated}}
        </div>
        {{#skipped}}
        <div class="card-footer text-muted small">{{skipped}} AU(s) skipped — already mapped.</div>
        {{/skipped}}
    </div>
    {{/mapresults}}
    {{/hasmapresults}}

    <p class="text-muted">
        {{#str}}librarymapping_scope, local_rangeos{{/str}}
        <a href="{{globalmappingsurl}}">{{#str}}aumappings_global, local_rangeos{{/str}}</a>
    </p>

    {{#hasselectedpackage}}
    <h4 class="mb-3">{{packagetitle}}</h4>
    {{/hasselectedpackage}}

    {{#hasaus}}
    <p class="text-muted small">{{rowsummary}}</p>
    <div class="table-responsive rangeos-table-panel">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                {{#showpackagecolumn}}
                <th style="width:8%">CMI5 Package</th>
                {{/showpackagecolumn}}
                <th style="width:9%">{{#str}}type, local_rangeos{{/str}}</th>
                <th style="width:14%">{{#str}}au_title, local_rangeos{{/str}}</th>
                <th style="width:14%">{{#str}}au_iri, local_rangeos{{/str}}</th>
                <th style="width:14%">{{#str}}scenarios, local_rangeos{{/str}}</th>
                <th style="width:14%">Activity</th>
                {{#hasselectedpackage}}
                <th style="width:7%">{{#str}}classmode, local_rangeos{{/str}}</th>
                {{/hasselectedpackage}}
                <th style="width:10%">{{#str}}actions{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#aus}}
            <tr>
                {{#showpackagecolumn}}
                <td>
                    {{#haspackageinfo}}
                    <span class="small">{{packagetitle}}</span>
                    {{/haspackageinfo}}
                    {{^haspackageinfo}}
                    <span class="text-muted small">&mdash;</span>
                    {{/haspackageinfo}}
                </td>
                {{/showpackagecolumn}}
                <td>
                    <span class="badge badge-secondary mr-1">cmi5</span>
                    {{#israngeos}}
                    <span class="badge badge-primary" title="{{scenarioname}}">RangeOS</span>
                    {{/israngeos}}
                </td>
                <td>
                    {{title}}
                    {{#israngeos}}{{#scenarioname}}
                    <br><small class="text-muted">{{scenarioname}}</small>
                    {{/scenarioname}}{{/israngeos}}
                </td>
                <td><code class="small text-break" title="{{auid}}">{{auid_short}}</code></td>
                <td>
                    {{#israngeos}}
                        {{#scenario_count}}
                        {{#scenario_badges}}
                        <span class="badge badge-info mr-1 mb-1">{{.}}</span>
                        {{/scenario_badges}}
                        {{/scenario_count}}
                        {{^scenario_count}}
                        <span class="text-muted">None</span>
                        {{/scenario_count}}
                    {{/israngeos}}
                    {{^israngeos}}
                    <span class="text-muted">&mdash;</span>
                    {{/israngeos}}
                </td>
                <td>
                    {{#hasactivities}}
                    {{#activities}}
                    <div class="small">
                        <a href="{{{config.wwwroot}}}/mod/cmi5/view.php?id={{cmid}}">{{activityname}}</a>
                        <span class="text-muted">({{coursename}})</span>
                    </div>
                    {{/activities}}
                    {{/hasactivities}}
                    {{^hasactivities}}
                    <span class="text-muted small">&mdash;</span>
                    {{/hasactivities}}
                </td>
                {{#hasselectedpackage}}
                <td>
                    {{#israngeos}}
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input"
                               id="classmode-{{auid}}"
                               data-action="toggle-classmode"
                               data-auid="{{auid}}"
                               {{#classmode}}checked{{/classmode}}>
                        <label class="custom-control-label" for="classmode-{{auid}}"></label>
                    </div>
                    {{/israngeos}}
                    {{^israngeos}}
                    <span class="text-muted">&mdash;</span>
                    {{/israngeos}}
                </td>
                {{/hasselectedpackage}}
                <td>
                    {{#israngeos}}
                        {{#ismapped}}
                        <button class="btn btn-sm btn-outline-primary mr-1"
                                data-action="edit-mapping"
                                data-auid="{{auid}}"
                                data-autitle="{{mapping_name}}"
                                data-scenarios="{{scenarios_json}}">
                            {{#str}}edit{{/str}}
                        </button>
                        {{#firstscenariouuid}}
                        <button class="btn btn-sm btn-outline-success"
                                data-action="create-class"
                                data-scenariouuid="{{firstscenariouuid}}"
                                data-autitle="{{title}}">
                            {{#str}}createclass, local_rangeos{{/str}}
                        </button>
                        {{/firstscenariouuid}}
                        {{/ismapped}}
                        {{^ismapped}}
                        <button class="btn btn-sm btn-outline-primary mr-1"
                                data-action="create-mapping"
                                data-auid="{{auid}}"
                                data-autitle="{{title}}"
                                data-scenarios="[]">
                            Map
                        </button>
                        {{#scenarioname}}
                        {{^defaultscenariomissing}}
                        <button class="btn btn-sm btn-primary"
                                data-action="create-default-mapping"
                                data-auid="{{auid}}"
                                data-autitle="{{title}}"
                                data-defaultscenarioname="{{scenarioname}}"
                                title="{{scenarioname}}">
                            {{#str}}usedefault, local_rangeos{{/str}}
                        </button>
                        {{/defaultscenariomissing}}
                        {{#defaultscenariomissing}}
                        <span title="Not found in this environment: {{scenarioname}}">
                            <button class="btn btn-sm btn-danger" disabled style="pointer-events:none;">
                                {{#str}}usedefault, local_rangeos{{/str}}
                            </button>
                        </span>
                        {{/defaultscenariomissing}}
                        {{/scenarioname}}
                        {{/ismapped}}
                    {{/israngeos}}
                </td>
            </tr>
            {{/aus}}
        </tbody>
    </table>
    </div>
    {{/hasaus}}

    {{^hasaus}}
    {{^haserror}}
    <div class="alert alert-info rangeos-empty-state">
        {{#str}}nolibraryaus, local_rangeos{{/str}}
    </div>
    {{/haserror}}
    {{/hasaus}}

</div>

{{#js}}
require(['core/first'], function() {
    var container = document.querySelector('[data-versionid]');
    var envSelect = document.getElementById('rangeos-env-select');
    var pkgSelect = document.getElementById('rangeos-package-select');
    var perpageSelect = document.getElementById('rangeos-perpage-select');

    function applyFilters() {
        var url = new URL(container.dataset.baseurl, window.location.href);
        url.searchParams.set('envid', envSelect ? envSelect.value : '0');
        if (pkgSelect) {
            url.searchParams.set('packageid', pkgSelect.value);
        }
        if (perpageSelect) {
            url.searchParams.set('perpage', perpageSelect.value);
        }
        url.searchParams.set('page', '0');
        window.location.href = url.toString();
    }

    if (pkgSelect) {
        pkgSelect.addEventListener('change', applyFilters);
    }
    if (perpageSelect) {
        perpageSelect.addEventListener('change', applyFilters);
    }
});
{{/js}}
