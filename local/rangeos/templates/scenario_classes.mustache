{{!
    Scenario classes management page.

    @template   local_rangeos/scenario_classes
    @copyright  2026 Bylight
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div data-baseurl="{{baseurl}}" data-envid="{{envid}}">
    <div class="rangeos-toolbar">
        {{> local_rangeos/environment_selector }}
    </div>

    {{^hasenvironments}}
    {{#emptyenvironments}}
    {{> local_rangeos/empty_state }}
    {{/emptyenvironments}}
    {{/hasenvironments}}

    {{#haserror}}
    <div class="alert alert-danger">{{error}}</div>
    {{/haserror}}

    {{! With no classes the empty state below carries this action, so it is not offered
        twice; with no environment there is nothing to create a class against either. }}
    {{#hasclasses}}
    <div class="rangeos-actions">
        <button class="btn btn-primary" data-action="create-class">
            {{#str}}createclass, local_rangeos{{/str}}
        </button>
    </div>
    {{/hasclasses}}

    {{#hasclasses}}
    <div class="table-responsive rangeos-table-panel">
    <table class="table" id="classes-table">
        <thead>
            <tr>
                <th class="rangeos-class-col-id">{{#str}}classid, local_rangeos{{/str}}</th>
                <th class="rangeos-class-col-seats">{{#str}}classinstances, local_rangeos{{/str}}</th>
                <th>{{#str}}actions{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#classes}}
            <tr data-classname="{{name}}" data-rangeid="{{rangeid}}">
                <td>
                    <strong>{{name}}</strong>
                </td>
                <td>
                    <span class="text-muted instance-count" data-classname="{{name}}">
                        {{#str}}loading, local_rangeos{{/str}}
                    </span>
                </td>
                <td class="rangeos-row-actions">
                    <button class="btn btn-sm btn-outline-info"
                            data-action="view-instances"
                            data-classname="{{name}}"
                            data-rangeid="{{rangeid}}">
                        {{#str}}viewinstances, local_rangeos{{/str}}
                    </button>
                    <button class="btn btn-sm btn-outline-success"
                            data-action="add-seats"
                            data-classname="{{name}}">
                        {{#str}}addseats, local_rangeos{{/str}}
                    </button>
                    <button class="btn btn-sm btn-outline-danger"
                            data-action="delete-class"
                            data-classname="{{name}}">
                        {{#str}}deleteclass, local_rangeos{{/str}}
                    </button>
                </td>
            </tr>
            {{/classes}}
        </tbody>
    </table>
    </div>
    {{/hasclasses}}

    {{#hasenvironments}}
    {{^hasclasses}}
    {{#emptyrows}}
    {{> local_rangeos/empty_state }}
    {{/emptyrows}}
    {{/hasclasses}}
    {{/hasenvironments}}

    <!-- Expandable instances detail area -->
    <div id="class-instances-detail" class="mt-3" hidden>
        <h5 id="class-instances-title" class="rangeos-section-title"></h5>
        <div class="table-responsive rangeos-table-panel">
        <table class="table table-sm table-bordered">
            <thead>
                <tr>
                    <th>{{#str}}seat, local_rangeos{{/str}}</th>
                    <th>{{#str}}scenarioname, local_rangeos{{/str}}</th>
                    <th>{{#str}}status, local_rangeos{{/str}}</th>
                    <th>{{#str}}assignedto, local_rangeos{{/str}}</th>
                    <th>{{#str}}instanceid, local_rangeos{{/str}}</th>
                    <th>{{#str}}actions{{/str}}</th>
                </tr>
            </thead>
            <tbody id="class-instances-body">
            </tbody>
        </table>
        </div>
    </div>
</div>
